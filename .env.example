# Claude
ANTHROPIC_API_KEY=

# Upstash Redis (auto-injected on Vercel by the Upstash integration; set manually for local dev)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=

# Ops data sources
VERCEL_TOKEN=
GITHUB_TOKEN=

# Protects /api/cron/run and /api/cron/poll (also a GitHub Actions repo secret)
CRON_SECRET=

# /admin login (password falls back to legacy DASHBOARD_PASSCODE)
ADMIN_USER=
ADMIN_PASSWORD=

# Shared Neon Postgres holding kb_entry (same DB as kb.nanoteofficial.me).
# Unset = KB reads/writes fail soft to empty/no-op.
DATABASE_URL=

# Finance's thai-funds-mcp connector (optional; unset = web_search only)
THAI_FUNDS_MCP_URL=
THAI_FUNDS_MCP_TOKEN=

# Optional: model override (default claude-haiku-4-5-20251001) and budget alerting
CLAUDE_MODEL=
MONTHLY_BUDGET_USD=

# Vercel deploy webhook secret. Set = requests must carry a valid x-vercel-signature;
# unset = the webhook is unauthenticated.
VERCEL_WEBHOOK_SECRET=
